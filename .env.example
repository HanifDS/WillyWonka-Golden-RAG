# Copy this file to .env and fill in the values you use.
# Never commit .env.

# --- AWS / boto3 ---
# Leave these three blank if you only have a Bedrock API key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bedrock API key from the AWS console (paste as-is, no quotes or parentheses)
AWS_BEARER_TOKEN_BEDROCK=

AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Bedrock model used for generation (change to a model you have access to)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Optional LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- RAG ---
RAG_DATA_DIR=data/raw
RAG_INDEX_DIR=data/index

# --- S3 (IAM via ~/.aws; not the Bedrock API key) ---
# IAM user that can read the RAG bucket.
AWS_PROFILE=cloud_user
S3_BUCKET=wonka-industries-rag-data
S3_PREFIX=

# Bedrock Knowledge Base (chunking already done in AWS)
BEDROCK_KNOWLEDGE_BASE_ID=A30YI231W3
